{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Parle",
  "version": "0.1.0",
  "identifier": "com.novaire.parle",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/build-hook.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Parle",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 520,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "On-device AI dictation and clipboard history",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "Parle Dev"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": [
      "icons/variants/*"
    ],
    "externalBin": [
      "binaries/parle-hook"
    ]
  }
}
