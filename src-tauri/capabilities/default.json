{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window + HUD capabilities",
  "windows": ["main", "hud"],
  "permissions": [
    "core:default",
    "opener:default",
    "global-shortcut:default",
    "autostart:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
